generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persona {
  id          Int         @id @default(autoincrement())
  nombre      String
  apellido    String
  dni         String?
  telefono    String?
  direccion   String?
  fechaNac    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  citas       Cita[]
  empleado    Empleado?
  expedientes Expediente?
  user        User?
  facturasEmitidas Factura[]
}

model User {
  id        Int      @id @default(autoincrement())
  correo    String   @unique
  password  String?
  rol       Rol      @default(CLIENTE)
  activo    Boolean  @default(true)
  verificado  Boolean @default(false) // NUEVO CAMPO
  personaId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persona   Persona  @relation(fields: [personaId], references: [id])
  codigos   CodigoVerificacion?


}

model CodigoVerificacion {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique // Relación 1:1 con el usuario (solo puede haber un código activo por usuario)
  codigo           String   // El código de 6 dígitos o alfanumérico generado
  fechaCreacion    DateTime @default(now())
  fechaExpiracion  DateTime // El momento en que el código deja de ser válido (Ej: 15 minutos después de la creación)
  usado            Boolean  @default(false) // Indica si el código ya fue consumido
  
  user             User     @relation(fields: [userId], references: [id])
}

model Empleado {
  id                   Int                 @id @default(autoincrement())
  personaId            Int                 @unique
  puesto               Puesto
  salario              Float
  fechaIngreso         DateTime            @default(now())
  activo               Boolean             @default(true)
  citas                Cita[]
  persona              Persona             @relation(fields: [personaId], references: [id])
  archivosCreados      ExpedienteArchivo[]
  detalles             ExpedienteDetalle[]
  expedientesAsociados ExpedienteDoctor[]
  logs                 Logs[]
  facturasAsociadas Factura[]
  especialidades   EspecialidadDoctor[]
}

model Especialidad {
  id               Int                      @id @default(autoincrement())
  nombre           String                   @unique
  descripcion      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  
  // Relaciones de unión
  doctores         EspecialidadDoctor[]
  servicios        ServicioEspecialidad[]
}

model EspecialidadDoctor {
  doctorId         Int
  especialidadId   Int
  fechaAsociacion  DateTime                 @default(now())

  doctor           Empleado                 @relation(fields: [doctorId], references: [id])
  especialidad     Especialidad             @relation(fields: [especialidadId], references: [id])

  @@id([doctorId, especialidadId]) // Clave compuesta para asegurar unicidad
}

model ServicioEspecialidad {
  servicioId       Int
  especialidadId   Int
  
  servicio         ServicioClinico          @relation(fields: [servicioId], references: [id])
  especialidad     Especialidad             @relation(fields: [especialidadId], references: [id])

  @@id([servicioId, especialidadId]) // Clave compuesta
}

model ServicioClinico {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  citas       Cita[]
  detallesFactura DetalleFactura[]
  especialidades   ServicioEspecialidad[]
  
}

model Expediente {
  id                Int                 @id @default(autoincrement())
  pacienteId        Int                 @unique
  alergias          String?
  enfermedades      String?
  medicamentos      String?
  observaciones     String?
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  paciente          Persona             @relation(fields: [pacienteId], references: [id])
  archivos          ExpedienteArchivo[]
  detalles          ExpedienteDetalle[]
  doctoresAsociados ExpedienteDoctor[]
}

model ExpedienteDoctor {
  expedienteId    Int
  doctorId        Int
  fechaAsociacion DateTime   @default(now())
  doctor          Empleado   @relation(fields: [doctorId], references: [id], onUpdate: NoAction)
  expediente      Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([expedienteId, doctorId])
}

model ExpedienteDetalle {
  id              Int        @id @default(autoincrement())
  expedienteId    Int
  fecha           DateTime
  motivo          String?
  diagnostico     String?
  tratamiento     String?
  planTratamiento String?
  doctorId        Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  doctor          Empleado   @relation(fields: [doctorId], references: [id])
  expediente      Expediente @relation(fields: [expedienteId], references: [id])
}

model ExpedienteArchivo {
  id            Int        @id @default(autoincrement())
  expedienteId  Int
  nombreArchivo String
  tipoArchivo   String?
  creadoPorId   Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  filePath      String
  storageName   String     @unique
  creadoPor     Empleado   @relation(fields: [creadoPorId], references: [id])
  expediente    Expediente @relation(fields: [expedienteId], references: [id])
}

model Cita {
  id                       Int                       @id @default(autoincrement())
  fecha                    String
  estado                   EstadoCita                @default(PENDIENTE)
  pacienteId               Int
  doctorId                 Int
  servicioId               Int
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  hora                     String
  recordatorio1h           Boolean                   @default(false)
  recordatorio24h          Boolean                   @default(false)
  doctor                   Empleado                  @relation(fields: [doctorId], references: [id])
  paciente                 Persona                   @relation(fields: [pacienteId], references: [id])
  servicio                 ServicioClinico           @relation(fields: [servicioId], references: [id])
  HistorialCancelacionCita HistorialCancelacionCita?
  factura          Factura?          
}

model HistorialCancelacionCita {
  id                Int      @id @default(autoincrement())
  citaId            Int      @unique
  motivoCancelacion String
  usuarioCancelaId  Int
  rolCancela        String   @db.VarChar(50)
  fechaCancelacion  DateTime @default(now()) @db.Timestamptz(6)
  Cita              Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Logs {
  id             Int       @id @default(autoincrement())
  empleadoId     Int
  empleado       Empleado  @relation(fields: [empleadoId], references: [id])
  login          DateTime  @default(now())
  logout         DateTime?  @default(now())
}

model Factura {
  id               Int                @id @default(autoincrement())
  numeroFactura    String             @unique // OBLIGATORIO: Número correlativo del documento fiscal.
  cai              String // OBLIGATORIO: Clave de Autorización (CAI).
  fechaEmision     DateTime           @default(now())
  pacienteId       Int
  doctorId         Int?               // El doctor que prestó el servicio
  subtotal         Float
  descuentos       Float              @default(0)
  importeExonerado Float              @default(0)
  importeExento    Float              @default(0)
  isv15            Float              @default(0)
  isv18            Float              @default(0)
  totalPagar       Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  paciente         Persona            @relation(fields: [pacienteId], references: [id])
  doctor           Empleado?          @relation(fields: [doctorId], references: [id])
  detalles         DetalleFactura[]

  citaId           Int?               @unique
  cita             Cita?              @relation(fields: [citaId], references: [id])
}

model DetalleFactura {
  id                Int             @id @default(autoincrement())
  facturaId         Int
  servicioId        Int?           
  descripcion       String         
  cantidad          Int
  precioUnitario    Float
  totalLinea        Float
  aplicaISV         Boolean         @default(true) // Indica si esta línea está gravada
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  factura           Factura         @relation(fields: [facturaId], references: [id])
  servicioClinico   ServicioClinico? @relation(fields: [servicioId], references: [id])

}


enum Rol {
  ADMIN
  DOCTOR
  RECEPCIONISTA
  CLIENTE
}

enum Puesto {
  DOCTOR
  RECEPCIONISTA
  ADMIN
  OTRO
}

enum EstadoCita {
  PENDIENTE
  COMPLETADA
  CANCELADA
  CONFIRMADA
}

